# Copy to .env.pi (git-ignored) and fill in. Never commit the real file.
# On Windows the secrets are stored DPAPI-encrypted (*_DPAPI) and read with
#   .\scripts\pi-secret.ps1 PI_PASSWORD
PI_HOST=smar-gardon.local
PI_USER=admin
PI_SSH_KEY=~/.ssh/smart_garden_pi
PI_PASSWORD_DPAPI=<ConvertTo-SecureString '<password>' -AsPlainText -Force | ConvertFrom-SecureString>
GITLAB_REPO=gitlab.unimelb.edu.au/smart-garden-capstone/smart-garden-iot-dashboard.git
GITLAB_TOKEN_DPAPI=<same, for a GitLab token with read_repository>
